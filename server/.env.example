# Copy to server/.env and adjust as needed. The server auto-loads this file via
# dotenv on start/dev/migrate/seed. Shell/CI env vars take precedence; ignored under NODE_ENV=test.
PORT=3000
NODE_ENV=development
# SQLite database file path. Defaults to server/data/table-order.sqlite when unset.
# Use :memory: for an ephemeral in-memory database.
DB_PATH=

# CORS allowed origins for the P3/P4 SPAs. Comma-separated, or '*' for any (local dev).
# e.g. CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ORIGINS=

# --- Auth (P1) ---
# JWT signing secret. MUST be set to a strong random value in real deployments.
JWT_SECRET=
JWT_EXPIRES_IN=16h
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
