# Copy to .env and adjust as needed (dotenv not required; these are read from process.env)
PORT=3000
NODE_ENV=development
# SQLite database file path. Defaults to server/data/table-order.sqlite when unset.
# Use :memory: for an ephemeral in-memory database.
DB_PATH=

# --- Auth (P1) ---
# JWT signing secret. MUST be set to a strong random value in real deployments.
JWT_SECRET=
JWT_EXPIRES_IN=16h
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
